---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/atoms/Container.astro';
import Section from '../components/atoms/Section.astro';
import Button from '../components/atoms/Button.astro';
import Eyebrow from '../components/atoms/Eyebrow.astro';
import Heading from '../components/atoms/Heading.astro';
import Text from '../components/atoms/Text.astro';
import Icon from '../components/atoms/Icon.astro';
import SectionHeader from '../components/molecules/SectionHeader.astro';
import IconCard from '../components/molecules/IconCard.astro';
import ServiceCard from '../components/molecules/ServiceCard.astro';
import PostCard from '../components/molecules/PostCard.astro';
import CheckList from '../components/molecules/CheckList.astro';
import TrustBar from '../components/organisms/TrustBar.astro';
import ProcessSteps from '../components/organisms/ProcessSteps.astro';
import FaqList from '../components/organisms/FaqList.astro';
import CtaBanner from '../components/organisms/CtaBanner.astro';
import { site, triggers, valueAdded } from '../data/site';
import { services } from '../data/services';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <Container>
      <div class="hero__grid">
        <div class="hero__copy">
          <Eyebrow>Workplace investigations · Ontario</Eyebrow>
          <Heading level={1} size="xl" class="hero__title">
            Build wealthier &amp; healthier workplaces — <em>starting with a fair investigation.</em>
          </Heading>
          <Text size="lg" tone="muted" measure>
            Independent, conduct-based investigations into harassment, discrimination and violence — led by an
            employment lawyer, so your findings hold up and your people can move forward.
          </Text>
          <div class="hero__actions">
            <Button href="/contact" size="lg" icon="arrow" cta="hero:consult">Book a free consultation</Button>
            <Button href={site.phone.href} size="lg" variant="secondary" icon="phone" iconPosition="start" cta="hero:phone">
              {site.phone.display}
            </Button>
          </div>
          <p class="hero__assure">
            <Icon name="lock" size={15} /> Confidential first conversation · <Icon name="globe" size={15} /> Se habla español
          </p>
        </div>

        <figure class="hero__media">
          <img src="/brand/hero.jpg" alt="Professional in a dark suit at the foot of a staircase" width="1600" height="1067" fetchpriority="high" />
          <figcaption class="hero__card">
            <img src="/brand/antonio-urdaneta.jpg" alt="" width="56" height="56" />
            <span>
              <strong>{site.lawyer}</strong>
              <small>Lawyer &amp; Workplace Investigator</small>
            </span>
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>

  <TrustBar />

  <!-- TRIGGERS: problem-aware visitors self-identify -->
  <Section labelledby="triggers-title">
    <Container>
      <SectionHeader
        id="triggers-title"
        eyebrow="When to call"
        title="An allegation has surfaced. <em>Now what?</em>"
        lede="Ontario employers must investigate complaints of workplace harassment and violence — and should investigate other misconduct. We help you respond promptly, fairly and defensibly."
      />
      <div class="triggers">
        {triggers.map((t) => <IconCard icon={t.icon} title={t.title} text={t.text} href="/contact" />)}
      </div>
    </Container>
  </Section>

  <!-- APPROACH -->
  <Section tone="surface" labelledby="approach-title">
    <Container>
      <div class="approach">
        <div class="approach__copy">
          <SectionHeader id="approach-title" eyebrow="The approach" title="Fit-for-purpose legal services, <em>built around conduct</em>" />
          <Text size="md" measure>
            Workplace Legal is an innovative, fit-for-purpose legal services framework focused on conduct-based workplace
            investigations. It is designed to empower leaders to reduce the inherent legal threats coming from workplace
            conduct.
          </Text>
          <Text tone="muted" measure>
            We contribute to improving the work climate — procuring a positive lifetime experience with the law in and
            around the workplace, in businesses, campuses and institutions.
          </Text>
          <Button href="/contact" variant="link" icon="arrow" cta="approach:schedule">Schedule time with the investigator</Button>
        </div>
        <aside class="approach__value">
          <h3 class="approach__value-title">Value added</h3>
          <CheckList items={valueAdded} />
        </aside>
      </div>
    </Container>
  </Section>

  <!-- SERVICES -->
  <Section tone="muted" labelledby="services-title">
    <Container>
      <SectionHeader
        id="services-title"
        eyebrow="Services"
        title="From prevention <em>to resolution</em>"
        lede="Investigations are the core. Training, advisory and representation keep the same issues from coming back."
      />
      <div class="services">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
    </Container>
  </Section>

  <ProcessSteps />

  <!-- ABOUT TEASER -->
  <Section labelledby="about-title">
    <Container>
      <div class="about">
        <img src="/brand/antonio-urdaneta.jpg" alt="Antonio F. Urdaneta, lawyer" width="519" height="585" loading="lazy" class="about__photo" />
        <div class="about__copy">
          <Eyebrow>Meet the investigator</Eyebrow>
          <Heading level={2} size="lg" id="about-title">{site.lawyer}</Heading>
          <Text size="md" measure>
            The thought leader behind Workplace Legal — and a marathon runner — Antonio improves the work climate and
            empowers business leaders, managers and HR professionals to reduce the inherent threats of workplace relations.
          </Text>
          <blockquote class="about__quote">“A positive lifetime experience with the law at the workplace.”</blockquote>
          <div class="about__actions">
            <Button href="/about" variant="secondary" icon="arrow" cta="about-teaser:about">About Antonio</Button>
            <Button href={site.social.linkedin} variant="ghost" icon="linkedin" iconPosition="start">LinkedIn</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- INSIGHTS -->
  <Section tone="surface" labelledby="insights-title">
    <Container>
      <div class="insights__head">
        <SectionHeader id="insights-title" eyebrow="Insights" title="Thinking on investigations, <em>trust and fairness</em>" />
        <Button href="/blog" variant="secondary" icon="arrow">All articles</Button>
      </div>
      <div class="insights">
        {posts.map((p) => <PostCard slug={p.id} {...p.data} />)}
      </div>
    </Container>
  </Section>

  <FaqList />

  <CtaBanner source="home" />
</BaseLayout>

<style>
  .hero {
    padding: var(--space-9) 0 var(--space-10);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-9);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
  }
  .hero__copy :global(.hero__title) {
    font-size: var(--text-3xl);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .hero__assure {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
  .hero__media {
    position: relative;
    margin: 0;
  }
  .hero__media > img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  /* Logo motif: offset ring framing the image */
  .hero__media::before {
    content: '';
    position: absolute;
    inset: -2.5rem -2.5rem auto auto;
    width: 12rem;
    height: 12rem;
    border: 1px solid var(--wpl-burgundy-100);
    border-radius: 50%;
    z-index: -1;
  }
  .hero__card {
    position: absolute;
    left: -1.5rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5) var(--space-3) var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-lg);
  }
  .hero__card img {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }
  .hero__card span {
    display: grid;
    line-height: 1.3;
  }
  .hero__card strong {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }
  .hero__card small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  @media (max-width: 999px) {
    .hero__media {
      max-width: 32rem;
    }
    .hero__media > img {
      aspect-ratio: 4 / 3;
    }
    .hero__card {
      left: var(--space-4);
      bottom: var(--space-4);
    }
  }

  .triggers {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  @media (min-width: 900px) {
    .triggers {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .approach {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 960px) {
    .approach {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-10);
    }
  }
  .approach__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }
  .approach__copy :global(.section-header) {
    margin-bottom: var(--space-2);
  }
  .approach__value {
    padding: var(--space-7);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand);
    border-radius: var(--radius-sm);
  }
  .approach__value-title {
    margin-bottom: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .services {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .about {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  @media (min-width: 860px) {
    .about {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-10);
    }
  }
  .about__photo {
    width: 100%;
    max-width: 26rem;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    padding: var(--space-3);
    background: var(--color-surface);
  }
  .about__copy {
    display: grid;
    gap: var(--space-5);
  }
  .about__quote {
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-brand);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .insights__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .insights__head :global(.section-header) {
    margin-bottom: 0;
  }
  .insights {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
