---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/atoms/Container.astro';
import Section from '../components/atoms/Section.astro';
import Button from '../components/atoms/Button.astro';
import Heading from '../components/atoms/Heading.astro';
import Text from '../components/atoms/Text.astro';
import Eyebrow from '../components/atoms/Eyebrow.astro';
---

<BaseLayout title="Page not found">
  <Section>
    <Container width="narrow">
      <div class="nf">
        <Eyebrow rule={false}>404</Eyebrow>
        <Heading level={1} size="xl">This page has <em>moved on.</em></Heading>
        <Text tone="muted">The link may be outdated. Try one of these instead:</Text>
        <div class="nf__actions">
          <Button href="/" variant="secondary">Home</Button>
          <Button href="/services" variant="secondary">Services</Button>
          <Button href="/blog" variant="secondary">Insights</Button>
          <Button href="/contact" icon="arrow">Contact us</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: var(--space-5);
    justify-items: center;
    text-align: center;
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
