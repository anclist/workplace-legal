---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/atoms/Container.astro';
import Section from '../../components/atoms/Section.astro';
import Button from '../../components/atoms/Button.astro';
import Heading from '../../components/atoms/Heading.astro';
import Eyebrow from '../../components/atoms/Eyebrow.astro';
import Icon from '../../components/atoms/Icon.astro';
import PostCard from '../../components/molecules/PostCard.astro';
import CtaBanner from '../../components/organisms/CtaBanner.astro';
import { site } from '../../data/site';
import { absoluteUrl } from '../../lib/url';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('posts')).sort((a, b) => a.data.order - b.data.order);
  return posts.map((post, i) => {
    // Neighbours first, then latest posts as filler.
    const related = [posts[i - 1], posts[i + 1], ...posts.slice(0, 4)]
      .filter((p, j, arr) => p && p.id !== post.id && arr.findIndex((q) => q?.id === p.id) === j)
      .slice(0, 3);
    return { params: { slug: post.id }, props: { post, related } };
  });
}) satisfies GetStaticPaths;

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, author, image } = post.data;
const shareUrl = encodeURIComponent(absoluteUrl(`/post/${post.id}`, Astro.site));

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image,
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: site.name },
};
---

<BaseLayout title={title} description={description} image={image || undefined} type="article" schema={articleSchema}>
  <article>
    <header class="post-head">
      <Container width="narrow">
        <a href="/blog" class="post-head__back"><Icon name="arrow-left" size={16} /> All insights</a>
        <Eyebrow>Insight</Eyebrow>
        <Heading level={1} size="xl">{title}</Heading>
        <p class="post-head__lede">{description}</p>
        <div class="post-head__meta">
          <img src="/brand/antonio-urdaneta.jpg" alt="" width="44" height="44" />
          <span><strong>{author}</strong><small>Lawyer &amp; Workplace Investigator</small></span>
        </div>
      </Container>
    </header>

    {
      image && (
        <Container>
          <img class="post-hero" src={image} alt="" width="1200" height="630" />
        </Container>
      )
    }

    <Section spacing="tight">
      <Container width="narrow">
        <div class="prose">
          <Content />
        </div>

        <aside class="post-cta" aria-label="Talk to the investigator">
          <div>
            <h2>Dealing with something similar?</h2>
            <p>Every situation is different. A short, confidential call can help you decide your next step.</p>
          </div>
          <div class="post-cta__actions">
            <Button href="/contact" icon="arrow" cta={`post-inline:${post.id}`}>Book a consultation</Button>
            <Button href={site.phone.href} variant="inverse" icon="phone" iconPosition="start" cta={`post-inline:${post.id}:phone`}>Call</Button>
          </div>
        </aside>

        <div class="post-share">
          <span>Share</span>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><Icon name="linkedin" size={18} /></a>
          <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" aria-label="Share on X"><Icon name="x" size={16} /></a>
          <a href={`mailto:?subject=${encodeURIComponent(title)}&body=${shareUrl}`} aria-label="Share by email"><Icon name="mail" size={18} /></a>
        </div>

        <p class="post-disclaimer">
          This article is for general information only and is not legal advice. See our <a href="/terms-of-use">Terms of Use</a>.
        </p>
      </Container>
    </Section>
  </article>

  <Section tone="surface" spacing="tight" labelledby="related-title">
    <Container>
      <Heading level={2} size="md" id="related-title" class="related-title">Keep reading</Heading>
      <div class="related">
        {related.map((p) => <PostCard slug={p.id} {...p.data} />)}
      </div>
    </Container>
  </Section>

  <CtaBanner source="post" />
</BaseLayout>

<style>
  .post-head {
    padding: var(--space-9) 0 var(--space-7);
  }
  .post-head :global(.container) {
    display: grid;
    gap: var(--space-5);
  }
  .post-head__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .post-head__back:hover {
    color: var(--color-brand);
  }
  .post-head__lede {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .post-head__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .post-head__meta img {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }
  .post-head__meta span {
    display: grid;
    line-height: 1.3;
    font-size: var(--text-sm);
  }
  .post-head__meta small {
    color: var(--color-text-subtle);
  }
  .post-hero {
    width: 100%;
    max-height: 32rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .post-cta {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-9);
    padding: var(--space-7);
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-action);
  }
  .post-cta h2 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
  }
  .post-cta p {
    margin-top: var(--space-2);
    color: var(--color-text-inverse-muted);
  }
  .post-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .post-share {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-7);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .post-share span {
    margin-right: var(--space-2);
  }
  .post-share a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    color: var(--color-text);
  }
  .post-share a:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
  .post-disclaimer {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .post-disclaimer a {
    color: inherit;
  }

  :global(.related-title) {
    margin-bottom: var(--space-6);
  }
  .related {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
