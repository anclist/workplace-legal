---
import Icon from '../atoms/Icon.astro';

interface Props {
  items: readonly string[];
  columns?: 1 | 2;
}
const { items, columns = 1 } = Astro.props;
---

<ul class:list={['checklist', `checklist--cols-${columns}`]}>
  {
    items.map((item) => (
      <li>
        <span class="checklist__tick"><Icon name="check" size={14} /></span>
        {item}
      </li>
    ))
  }
</ul>

<style>
  .checklist {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .checklist--cols-2 {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-6);
    }
  }
  .checklist li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-weight: var(--weight-medium);
  }
  .checklist__tick {
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.1rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-action);
    color: var(--color-action-text);
  }
</style>
