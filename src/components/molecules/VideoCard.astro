---
import Badge from '../atoms/Badge.astro';
import Icon from '../atoms/Icon.astro';
import type { MediaItem } from '../../data/media';

interface Props {
  item: MediaItem;
}
const { item } = Astro.props;
---

<article class="video-card">
  <!-- Facade: loads the YouTube iframe only on click to keep the page fast. -->
  <button class="video-card__player" type="button" data-video={item.id} aria-label={`Play: ${item.title}`}>
    <img src={`https://i.ytimg.com/vi/${item.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="video-card__play"><Icon name="play" size={22} /></span>
  </button>
  <div class="video-card__body">
    <div class="video-card__tags">
      <Badge tone={item.lang === 'ES' ? 'brand' : 'accent'}>{item.lang === 'ES' ? 'Español' : 'English'}</Badge>
      <Badge>{item.topic}</Badge>
    </div>
    <h3 class="video-card__title">{item.title}</h3>
  </div>
</article>

<style>
  .video-card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .video-card__player {
    position: relative;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: var(--color-surface-inverse);
    cursor: pointer;
    overflow: hidden;
  }
  .video-card__player img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity var(--duration-base) var(--ease-out), transform 600ms var(--ease-out);
  }
  .video-card__player:hover img {
    opacity: 1;
    transform: scale(1.03);
  }
  .video-card__player :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-card__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: var(--radius-full);
    background: var(--color-action);
    color: var(--color-action-text);
    box-shadow: var(--shadow-lg);
    padding-left: 3px;
  }
  .video-card__body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5);
  }
  .video-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .video-card__title {
    font-family: var(--font-ui);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach((btn) => {
    btn.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.video}?autoplay=1`;
        iframe.title = btn.getAttribute('aria-label') ?? 'Video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        btn.replaceChildren(iframe);
      },
      { once: true },
    );
  });
</script>
