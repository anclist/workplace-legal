---
import Icon from '../atoms/Icon.astro';

interface Props {
  icon: string;
  label: string;
  value: string;
  href?: string;
  note?: string;
  cta?: string;
}
const { icon, label, value, href, note, cta } = Astro.props;
const Tag = href ? 'a' : 'div';
const external = href?.startsWith('http');
---

<Tag class="contact-method" href={href} data-cta={cta} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
  <span class="contact-method__icon"><Icon name={icon} size={20} /></span>
  <span class="contact-method__body">
    <span class="contact-method__label">{label}</span>
    <span class="contact-method__value">{value}</span>
    {note && <span class="contact-method__note">{note}</span>}
  </span>
</Tag>

<style>
  .contact-method {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    color: inherit;
    text-decoration: none;
  }
  .contact-method__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-action-soft);
    color: var(--color-brand);
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  a.contact-method:hover .contact-method__icon {
    background: var(--color-action);
    color: var(--color-action-text);
  }
  .contact-method__body {
    display: grid;
    gap: 2px;
  }
  .contact-method__label {
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }
  .contact-method__value {
    font-weight: var(--weight-semibold);
  }
  .contact-method__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  :global([data-theme='inverse']) .contact-method__icon {
    background: rgb(255 255 255 / 0.08);
    color: var(--wpl-sand-300);
  }
  :global([data-theme='inverse']) .contact-method__label,
  :global([data-theme='inverse']) .contact-method__note {
    color: var(--color-text-inverse-muted);
  }
</style>
