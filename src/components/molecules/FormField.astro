---
interface Props {
  label: string;
  for: string;
  required?: boolean;
  hint?: string;
  span?: 1 | 2;
}
const { label, for: htmlFor, required = false, hint, span = 1 } = Astro.props;
---

<div class:list={['field', { 'field--span': span === 2 }]}>
  <label for={htmlFor} class="field__label">
    {label}
    {required ? <span class="field__req" aria-hidden="true">*</span> : <span class="field__opt">optional</span>}
  </label>
  <slot />
  {hint && <p class="field__hint" id={`${htmlFor}-hint`}>{hint}</p>}
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .field--span {
    grid-column: 1 / -1;
  }
  .field__label {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .field__req {
    color: var(--color-brand);
  }
  .field__opt {
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--color-text-subtle);
  }
  .field__hint {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
</style>
