---
import Container from '../atoms/Container.astro';
import Eyebrow from '../atoms/Eyebrow.astro';
import Heading from '../atoms/Heading.astro';
import Text from '../atoms/Text.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__motif" aria-hidden="true"></div>
  <Container>
    <div class="page-hero__inner">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <Heading level={1} size="xl"><Fragment set:html={title} /></Heading>
      {lede && <Text size="lg" tone="muted" measure>{lede}</Text>}
      <slot />
    </div>
  </Container>
</section>

<style>
  .page-hero {
    position: relative;
    padding: var(--space-10) 0 var(--space-9);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .page-hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
    max-width: 50rem;
  }
  /* Interlocking rings + horizon from the logo mark, as a quiet watermark. */
  .page-hero__motif {
    position: absolute;
    right: -6rem;
    top: 50%;
    width: 30rem;
    height: 30rem;
    translate: 0 -50%;
    border-radius: 50%;
    border: 1px solid var(--wpl-burgundy-100);
    pointer-events: none;
  }
  .page-hero__motif::before,
  .page-hero__motif::after {
    content: '';
    position: absolute;
    inset: 18% 22%;
    border: 1px solid var(--wpl-burgundy-100);
    border-radius: 50%;
  }
  .page-hero__motif::after {
    inset: 50% -20% auto;
    height: 1px;
    border: 0;
    background: var(--wpl-burgundy-100);
  }
  @media (max-width: 720px) {
    .page-hero__motif {
      opacity: 0.5;
      right: -14rem;
    }
  }
</style>
