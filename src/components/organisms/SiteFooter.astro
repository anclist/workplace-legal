---
import Logo from '../atoms/Logo.astro';
import Icon from '../atoms/Icon.astro';
import Container from '../atoms/Container.astro';
import { nav, site } from '../../data/site';
import { services } from '../../data/services';

const year = new Date().getFullYear();
---

<footer class="footer" data-theme="inverse">
  <Container>
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo tone="inverse" />
        <p class="footer__mission">“To leverage the legal system to shape wealthy and healthy workplaces.”</p>
        <div class="footer__social">
          <a href={site.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={18} /></a>
          <a href={site.social.twitter} target="_blank" rel="noopener" aria-label="X / Twitter"><Icon name="x" size={16} /></a>
        </div>
      </div>

      <div>
        <h2 class="footer__title">Services</h2>
        <ul class="footer__list">
          {services.map((s) => <li><a href={`/services#${s.slug}`}>{s.title}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="footer__title">Firm</h2>
        <ul class="footer__list">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          <li><a href={site.clientLoginUrl} target="_blank" rel="noopener">Client login</a></li>
        </ul>
      </div>

      <div>
        <h2 class="footer__title">Contact</h2>
        <ul class="footer__list footer__contact">
          <li><a href={site.phone.href} data-cta="footer:phone"><Icon name="phone" size={15} /> Tel {site.phone.display}</a></li>
          <li><span><Icon name="doc" size={15} /> Fax {site.fax.display}</span></li>
          <li><a href={`mailto:${site.email}`} data-cta="footer:email"><Icon name="mail" size={15} /> {site.email}</a></li>
          <li>
            <a href={site.address.mapUrl} target="_blank" rel="noopener">
              <Icon name="pin" size={15} />
              <span>{site.address.line1}<br />{site.address.city}, {site.address.region} {site.address.postal}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <p>© {year} Workplace Legal. All rights reserved.</p>
      <p>
        The information on this site is not legal advice. Contacting us does not create a lawyer-client relationship.
        <a href="/terms-of-use">Terms of Use</a>
      </p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse-muted);
    padding: var(--space-10) 0 var(--space-6);
    font-size: var(--text-sm);
  }
  .footer a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }
  .footer a:hover {
    color: var(--color-text-inverse);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 0.8fr 1.2fr;
    }
  }
  .footer__brand {
    display: grid;
    gap: var(--space-5);
    align-content: start;
  }
  .footer__mission {
    max-width: 28ch;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-style: italic;
    color: var(--wpl-sand-300);
  }
  .footer__social {
    display: flex;
    gap: var(--space-2);
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-border-inverse);
    border-radius: var(--radius-full);
  }
  .footer__title {
    margin-bottom: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-inverse);
  }
  .footer__list {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .footer__contact a,
  .footer__contact span {
    display: inline-flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .footer__contact :global(.icon) {
    margin-top: 0.2rem;
    color: var(--wpl-sand-400);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-9);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-inverse);
    font-size: var(--text-xs);
  }
  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .footer {
      padding-bottom: calc(var(--space-6) + 4.5rem);
    }
  }
</style>
