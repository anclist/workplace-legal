---
import Container from '../atoms/Container.astro';
import Icon from '../atoms/Icon.astro';

const points = [
  { icon: 'scale', label: 'Licensed lawyer', detail: 'Law Society of Ontario' },
  { icon: 'search', label: 'Independent investigator', detail: 'Conduct-based allegations' },
  { icon: 'globe', label: 'Bilingual', detail: 'English & Spanish interviews' },
  { icon: 'shield', label: 'Employer-side', detail: 'Businesses, campuses, institutions' },
];
---

<div class="trust">
  <Container>
    <ul class="trust__list">
      {
        points.map((p) => (
          <li>
            <Icon name={p.icon} size={22} />
            <span>
              <strong>{p.label}</strong>
              <small>{p.detail}</small>
            </span>
          </li>
        ))
      }
    </ul>
  </Container>
</div>

<style>
  .trust {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }
  .trust__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    padding: 0;
    list-style: none;
  }
  .trust__list li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-5) var(--space-4);
    color: var(--color-accent);
  }
  .trust__list li + li {
    border-left: 1px solid var(--color-border);
  }
  @media (max-width: 900px) {
    .trust__list li:nth-child(odd) {
      border-left: 0;
    }
  }
  .trust__list span {
    display: grid;
    line-height: 1.3;
  }
  .trust__list strong {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--color-text);
  }
  .trust__list small {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
