---
interface Props {
  title: string;
  note?: string;
  /** Usage snippet shown under the preview. */
  code?: string;
  tone?: 'default' | 'surface' | 'inverse';
  /** Let full-bleed organisms touch the frame edges. */
  flush?: boolean;
}
const { title, note, code, tone = 'surface', flush = false } = Astro.props;
---

<figure class="specimen">
  <figcaption class="specimen__head">
    <span class="specimen__title">{title}</span>
    {note && <span class="specimen__note">{note}</span>}
  </figcaption>
  <div
    class:list={['specimen__stage', `specimen__stage--${tone}`, { 'specimen__stage--flush': flush }]}
    data-theme={tone === 'inverse' ? 'inverse' : undefined}
  >
    <slot />
  </div>
  {
    code && (
      <details class="specimen__code">
        <summary>Code</summary>
        <pre><code>{code}</code></pre>
      </details>
    )
  }
</figure>

<style>
  .specimen {
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    overflow: hidden;
  }
  .specimen__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-ui);
  }
  .specimen__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }
  .specimen__note {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
  .specimen__stage {
    flex: 1;
    padding: var(--space-6);
    min-width: 0;
  }
  .specimen__stage--flush {
    padding: 0;
  }
  .specimen__stage--surface {
    background: var(--color-surface);
  }
  .specimen__stage--default {
    background: var(--color-bg);
  }
  .specimen__stage--inverse {
    background: var(--color-surface-inverse);
    color: var(--color-text-inverse);
  }
  .specimen__code {
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }
  .specimen__code summary {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-ui);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .specimen__code pre {
    margin: 0;
    padding: var(--space-4);
    overflow-x: auto;
    background: var(--wpl-slate-900);
    color: var(--wpl-sand-100);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    line-height: var(--leading-normal);
  }
</style>
