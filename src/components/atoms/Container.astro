---
interface Props {
  width?: 'default' | 'narrow' | 'wide';
  class?: string;
}
const { width = 'default', class: className } = Astro.props;
---

<div class:list={['container', `container--${width}`, className]}><slot /></div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .container--default { max-width: calc(var(--container-max) + var(--gutter) * 2); }
  .container--narrow { max-width: calc(var(--container-narrow) + var(--gutter) * 2); }
  .container--wide { max-width: calc(90rem + var(--gutter) * 2); }
</style>
