---
interface Props {
  tone?: 'neutral' | 'brand' | 'accent';
  class?: string;
}
const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .badge--neutral { background: var(--color-surface-muted); color: var(--color-text-muted); }
  .badge--brand { background: var(--color-action-soft); color: var(--color-brand); }
  .badge--accent { background: var(--wpl-slate-50); color: var(--wpl-slate-700); }
</style>
