---
interface Props {
  class?: string;
  rule?: boolean;
}
const { class: className, rule = true } = Astro.props;
---

<p class:list={['eyebrow', { 'eyebrow--rule': rule }, className]}><slot /></p>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  /* Short rule + node: echoes the horizon line & centre dot of the logo mark. */
  .eyebrow--rule::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: currentColor;
  }

  :global([data-theme='inverse']) .eyebrow {
    color: var(--wpl-sand-300);
  }
</style>
