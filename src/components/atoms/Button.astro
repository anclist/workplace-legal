---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'ghost' | 'inverse' | 'link';
type Size = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: Variant;
  size?: Size;
  icon?: string;
  iconPosition?: 'start' | 'end';
  type?: 'button' | 'submit';
  block?: boolean;
  /** Analytics label — emitted to dataLayer on click. */
  cta?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  type = 'button',
  block = false,
  cta,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const external = href?.startsWith('http');
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  href={href}
  type={href ? undefined : type}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  data-cta={cta}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={size === 'sm' ? 16 : 18} />}
  <span><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={size === 'sm' ? 16 : 18} class="btn__trail" />}
</Tag>

<style>
  .btn {
    --btn-bg: transparent;
    --btn-fg: var(--color-text);
    --btn-border: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--btn-py) var(--btn-px);
    border: 1px solid var(--btn-border);
    border-radius: var(--radius-sm);
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--font-ui);
    font-size: var(--btn-fs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn :global(.btn__trail) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .btn:hover :global(.btn__trail) {
    transform: translateX(3px);
  }

  .btn--sm { --btn-py: 0.5rem; --btn-px: 0.875rem; --btn-fs: var(--text-sm); }
  .btn--md { --btn-py: 0.8rem; --btn-px: 1.35rem; --btn-fs: 0.9375rem; }
  .btn--lg { --btn-py: 1rem; --btn-px: 1.75rem; --btn-fs: var(--text-base); }

  .btn--block {
    display: flex;
    width: 100%;
  }

  .btn--primary {
    --btn-bg: var(--color-action);
    --btn-fg: var(--color-action-text);
    box-shadow: var(--shadow-sm);
  }
  .btn--primary:hover {
    --btn-bg: var(--color-action-hover);
  }

  .btn--secondary {
    --btn-border: var(--color-text);
    --btn-fg: var(--color-text);
  }
  .btn--secondary:hover {
    --btn-bg: var(--color-text);
    --btn-fg: var(--color-surface);
  }

  .btn--ghost {
    --btn-fg: var(--color-text);
  }
  .btn--ghost:hover {
    --btn-bg: var(--color-surface-muted);
  }

  .btn--inverse {
    --btn-border: var(--color-border-inverse);
    --btn-fg: var(--color-text-inverse);
  }
  .btn--inverse:hover {
    --btn-bg: var(--color-text-inverse);
    --btn-fg: var(--color-surface-inverse);
  }

  .btn--link {
    --btn-fg: var(--color-link);
    padding-inline: 0;
  }
  .btn--link:hover span {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
